{
    "name": "intelligent-tab-group",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build && node fix-sw.js",
        "preview": "vite preview",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "check": "npm run lint && npm run format",
        "prepare": "husky",
        "check:release": "node scripts/check-release.mjs",
        "verify": "npm run lint && npm run format && npm run check:release && npm run build"
    },
    "devDependencies": {
        "@crxjs/vite-plugin": "^2.4.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "eslint": "^10.4.0",
        "eslint-plugin-svelte": "^3.17.1",
        "globals": "^17.6.0",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "lint-staged": "^17.0.5",
        "prettier": "^3.8.3",
        "prettier-plugin-svelte": "^4.0.1",
        "svelte": "^5.55.9",
        "vite": "^8.0.14",
        "vite-plugin-static-copy": "^4.1.0"
    },
    "lint-staged": {
        "*.{js,mjs,svelte}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{css,html}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "dompurify": "^3.4.8",
        "marked": "^18.0.5"
    }
}
