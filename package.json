{
    "name": "intelligent-workspace",
    "description": "Intelligent productivity workspace with automated tab grouping, side panel management, and workflow focus tools.",
    "version": "1.0.4",
    "type": "module",
    "packageManager": "pnpm@11.5.0",
    "scripts": {
        "dev": "vite",
        "build": "vite build && node fix-sw.js",
        "preview": "vite preview",
        "test": "node --test test/*.test.mjs",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "check": "pnpm run lint && pnpm run format && pnpm run test",
        "prepare": "husky",
        "generate:logos": "node scripts/generate-theme-logos.mjs",
        "check:release": "node scripts/check-release.mjs",
        "sync:policy": "node scripts/sync-policy.mjs",
        "verify": "pnpm run lint && pnpm run format && pnpm run test && pnpm run check:release && pnpm run build",
        "release": "pnpm run verify && pnpm run package",
        "package": "python3 scripts/package-extension.py"
    },
    "devDependencies": {
        "@crxjs/vite-plugin": "^2.7.1",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "eslint": "^10.12.0",
        "eslint-plugin-svelte": "^3.23.0",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.9",
        "prettier-plugin-svelte": "^4.1.1",
        "svelte": "^5.57.2",
        "vite": "^8.3.4",
        "vite-plugin-static-copy": "^4.1.1"
    },
    "lint-staged": {
        "*.{js,mjs,svelte}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{css,html}": [
            "prettier --write"
        ]
    }
}
