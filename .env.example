# Copy to .env.local (which git ignores) when you want the extension's donation panel
# to talk to a locally running payment site instead of production.
#
#   cd ../../Intelligent-Workspace-Web && npm run dev
#
# Then rebuild the extension. Leave this unset for any build you intend to publish:
# production is the default precisely so that nobody has to remember to switch it back.
VITE_PAYMENT_ORIGIN=http://localhost:4321
